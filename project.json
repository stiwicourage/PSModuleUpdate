{
  "ProjectName": "PSModuleUpdate",
  "Description": "Generic self-update functionality for PowerShell modules.",
  "Version": "0.1.0",
  "Preamble": [
    "Set-StrictMode -Version Latest",
    "$ErrorActionPreference = 'Stop'"
  ],
  "Manifest": {
    "Author": "Stiwi Gabriel Courage",
    "PowerShellHostVersion": "7.4",
    "GUID": "cc2a0585-ae0a-49df-a47a-2e70de88428f",
    "Tags": [],
    "ProjectUri": ""
  },
  "Package": {
    "Types": [
      "NuGet"
    ],
    "OutputDirectory": {
      "Path": "artifacts/packages",
      "Clean": true
    }
  },
  "Pester": {
    "CodeCoverage": {
      "Enabled": true,
      "Path": [
        "src/public/*.ps1",
        "src/private/**/*.ps1",
        "src/classes/*.ps1"
      ],
      "CoveragePercentTarget": 95,
      "OutputPath": "artifacts/coverage.xml",
      "OutputFormat": "JaCoCo"
    },
    "TestResult": {
      "Enabled": true,
      "OutputFormat": "NUnitXml"
    },
    "Output": {
      "Verbosity": "Detailed"
    }
  },
  "$schema": "https://www.novamoduletools.com/schema/v3/project.json"
}
